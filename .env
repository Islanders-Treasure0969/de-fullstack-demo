# ====================================================================
# de-fullstack-demo runtime environment
# ====================================================================
# This file IS committed to git. It contains:
#   - Non-secret config (hostnames, ports, dummy credentials for LocalStack)
#   - 1Password references (`op://`) for actual secrets
#
# Secrets never enter this file directly — `op run` resolves the URIs at
# runtime and injects them into the child process's env.
#
# Run any command with secrets injected:
#     op run --env-file=.env -- <command>
#
# The Makefile wraps every secret-needing target with `op run` automatically
# when the `op` CLI is detected on PATH.
#
# 1Password setup (first time only):
#     op signin
#     op item create --category="API Credential" \
#         --title=de-fullstack-demo --vault=Personal \
#         GITHUB_TOKEN[password]="<your PAT>" \
#         GITHUB_TARGET_REPOS="anthropics/claude-code,dbt-labs/dbt-core,..." \
#         GARAGE_S3_ACCESS_KEY="$(openssl rand -hex 16)" \
#         GARAGE_S3_SECRET_KEY[password]="$(openssl rand -hex 32)" \
#         GARAGE_RPC_SECRET[password]="$(openssl rand -hex 32)" \
#         GARAGE_ADMIN_TOKEN[password]="$(openssl rand -hex 32)" \
#         POSTGRES_PASSWORD[password]="$(openssl rand -hex 16)"
#
# Personal overrides go in `.env.local` (gitignored).
# ====================================================================

# --------------------------------------------------------------
# Local platform endpoints (NOT secrets)
# --------------------------------------------------------------
AWS_DEFAULT_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
GARAGE_S3_ENDPOINT=http://localhost:3900
GARAGE_S3_REGION=garage
LAKEKEEPER_BASE_URI=http://localhost:8181
LAKEKEEPER_WAREHOUSE=de_lab
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8080
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=de_lab
POSTGRES_USER=de_lab
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
GITHUB_API_BASE=https://api.github.com

# --------------------------------------------------------------
# Secrets — resolved by `op run`
# Vault and item name override-able via .env.local
# --------------------------------------------------------------
GITHUB_TOKEN=op://Personal/de-fullstack-demo/GITHUB_TOKEN
GITHUB_TARGET_REPOS=op://Personal/de-fullstack-demo/GITHUB_TARGET_REPOS
GARAGE_S3_ACCESS_KEY=op://Personal/de-fullstack-demo/GARAGE_S3_ACCESS_KEY
GARAGE_S3_SECRET_KEY=op://Personal/de-fullstack-demo/GARAGE_S3_SECRET_KEY
GARAGE_RPC_SECRET=op://Personal/de-fullstack-demo/GARAGE_RPC_SECRET
GARAGE_ADMIN_TOKEN=op://Personal/de-fullstack-demo/GARAGE_ADMIN_TOKEN
POSTGRES_PASSWORD=op://Personal/de-fullstack-demo/POSTGRES_PASSWORD
LOCALSTACK_AUTH_TOKEN=op://Personal/de-fullstack-demo/LOCALSTACK_AUTH_TOKEN
