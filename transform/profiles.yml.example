de_lab:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: ../docker/data/de_lab.duckdb
      threads: 4
      extensions:
        - httpfs
        - iceberg
      settings:
        s3_endpoint: localhost:3900
        s3_access_key_id: "{{ env_var('GARAGE_S3_ACCESS_KEY') }}"
        s3_secret_access_key: "{{ env_var('GARAGE_S3_SECRET_KEY') }}"
        s3_use_ssl: false
        s3_url_style: path
