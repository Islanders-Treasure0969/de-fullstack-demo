# Copy to .env and fill in. Never commit .env (it is gitignored).

# ========================================
# LocalStack
# ========================================
LOCALSTACK_AUTH_TOKEN=          # Optional, only for Hobby tier features
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localhost:4566

# ========================================
# Garage (S3-compatible object store)
# ========================================
GARAGE_RPC_SECRET=               # generate with: openssl rand -hex 32
GARAGE_ADMIN_TOKEN=              # generate with: openssl rand -hex 32
GARAGE_S3_ACCESS_KEY=
GARAGE_S3_SECRET_KEY=
GARAGE_S3_ENDPOINT=http://localhost:3900

# ========================================
# Lakekeeper (Iceberg REST catalog)
# ========================================
LAKEKEEPER_BASE_URI=http://localhost:8181
LAKEKEEPER_WAREHOUSE=de_lab

# ========================================
# Kafka (KRaft mode)
# ========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8080

# ========================================
# Postgres (operational mart)
# ========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=de_lab
POSTGRES_USER=de_lab
POSTGRES_PASSWORD=               # generate with: openssl rand -hex 16

# ========================================
# Temporal
# ========================================
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# ========================================
# GitHub API (for ingestion)
# ========================================
GITHUB_TOKEN=                    # PAT with `public_repo` read scope
GITHUB_TARGET_REPOS=             # comma-separated, e.g. "anthropics/claude-code,dbt-labs/dbt-core"
